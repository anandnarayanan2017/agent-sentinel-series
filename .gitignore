__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
*.duckdb
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
data/
models/
.terraform/
*.tfstate*
.DS_Store

# Secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem

# Real MCP server config (gateway URLs, tokens) — only the example is tracked
.mcp.json

# Real network-visibility host map (names real agent/M2M hosts) — only the
# .example.yaml template is tracked (docs/NETWORK_COLLECTOR.md). No default
# scan-state sidecar path is gitignored here: ScanJobConfig.state_path
# defaults to None (in-memory only; see collector/scan_config.py) and is not
# repo-relative when an operator opts in — there is nothing to ignore by
# default.
config/network_hosts.yaml

# Generated mTLS certs (run deploy/gen-certs.sh locally)
deploy/certs/*.crt
deploy/certs/*.key
deploy/certs/*.pem
deploy/certs/*.srl
deploy/certs/*.csr

# Server logs
/tmp/sentinel*.log

# IDE
.idea/
.vscode/
*.swp

# Working memory / task tracking — not product docs, may name real people
# or leak unrelated-repo details; never intended to ship
memory/
TASKS.md
