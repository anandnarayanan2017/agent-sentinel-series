# Phase 2 — environment variables for real cloud agents
# Copy to .env and fill in your credentials.
# The examples load these with python-dotenv if it's installed,
# or you can export them in your shell before running.

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Find these in: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-org.openai.azure.com
AZURE_OPENAI_KEY=...
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# The deployment name you created in Azure AI Studio:
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Sentinel ──────────────────────────────────────────────────────────────────
# Where the Sentinel API is running (default: local)
SENTINEL_API=http://localhost:8000
SENTINEL_POLICY=policies/fintech.yaml
